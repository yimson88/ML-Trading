[Unit]
Description=SMC ML Trading Telegram Signal Engine
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/mlapp/app
EnvironmentFile=-/opt/mlapp/app/.env
ExecStart=/opt/mlapp/app/venv/bin/python signal_engine.py --loop --interval-minutes 5
Restart=always
RestartSec=20

[Install]
WantedBy=multi-user.target
