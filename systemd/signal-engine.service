[Unit]
Description=SMC ML Trading Telegram Signal Engine
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_VPS_USER
WorkingDirectory=/home/YOUR_VPS_USER/ML-Trading
EnvironmentFile=-/home/YOUR_VPS_USER/ML-Trading/.env
ExecStart=/home/YOUR_VPS_USER/ML-Trading/venv/bin/python signal_engine.py --loop --interval-minutes 5
Restart=always
RestartSec=20

[Install]
WantedBy=multi-user.target
