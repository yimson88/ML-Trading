[Unit]
Description=SMC ML Trading Streamlit Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/mlapp/app
EnvironmentFile=-/opt/mlapp/app/.env
ExecStart=/opt/mlapp/app/venv/bin/streamlit run app.py --server.address 0.0.0.0 --server.port 8501
Restart=always
RestartSec=20

[Install]
WantedBy=multi-user.target
